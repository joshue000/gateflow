{
  "permissions": {
    "ask": [
      "Edit(claude/agents/pe-governance.md)",
      "Edit(claude/skills/gateflow-review/SKILL.md)",
      "Edit(claude/skills/_gateflow-shared/pe-agent-template.md)",
      "Edit(.claude/settings.json)",
      "Edit(.gateflow/config.json)",
      "Edit(.claude/hooks/protect-self-amendment.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-self-amendment.sh" }
        ]
      }
    ]
  }
}
